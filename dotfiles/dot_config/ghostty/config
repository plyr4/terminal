# font
font-family = JetBrainsMono Nerd Font
font-size = 14

# window style
theme = vader
window-colorspace = display-p3
font-thicken = true
window-padding-x = 12
window-padding-y = 4

# treat option as alt so shell alt-arrow word navigation works
macos-option-as-alt = true

# scrollback (ghostty measures the scrollback buffer in bytes, not lines)
scrollback-limit = 10000000

# behavior (audio bell is already off by default in ghostty)
confirm-close-surface = false

# macOS dock/app-switcher icon (uses ~/.config/ghostty/Ghostty.icns)
macos-icon = custom
