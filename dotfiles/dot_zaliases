# vscode / rider
alias code,='code .'
alias code.='code .'

# walks up the directory tree looking for .sln or .csproj files
_is_csharp_project() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    local matches=("$dir"/*.sln(N) "$dir"/*.csproj(N))
    (( ${#matches} > 0 )) && return 0
    dir="${dir:h}"
  done
  return 1
}

# code: open in Rider for C# projects, VS Code otherwise; bare comma opens current dir
code() {
  local target=("$@")
  [[ $@ == "," ]] && target=(".")

  if _is_csharp_project; then
    if command -v rider &>/dev/null; then
      rider "${target[@]}"
    else
      open -a "Rider" "${target[@]}"
    fi
  else
    command code "${target[@]}"
  fi
}
